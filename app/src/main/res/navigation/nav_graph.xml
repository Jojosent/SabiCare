<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- BOTTOM NAV — 4 main destinations                                -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.sabicare_j.ui.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home" />
        <action
            android:id="@+id/action_home_to_addEntry"
            app:destination="@id/addEntryFragment"
            app:enterAnim="@anim/slide_up"
            app:popExitAnim="@anim/slide_down" />

    <fragment
        android:id="@+id/trackerFragment"
        android:name="com.example.sabicare_j.ui.tracker.TrackerFragment"
        android:label="@string/nav_tracker"
        tools:layout="@layout/fragment_tracker">

        <!-- Navigate to AddEntry bottom sheet -->
        <action
            android:id="@+id/action_tracker_to_addEntry"
            app:destination="@id/addEntryFragment"
            app:enterAnim="@anim/slide_up"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/slide_down" />
    </fragment>

    <fragment
        android:id="@+id/resultsFragment"
        android:name="com.example.sabicare_j.ui.results.ResultsFragment"
        android:label="@string/nav_results"
        tools:layout="@layout/fragment_results" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.sabicare_j.ui.profile.ProfileFragment"
        android:label="@string/nav_profile"
        tools:layout="@layout/fragment_profile">

        <!-- Navigate to Add/Edit child -->
        <action
            android:id="@+id/action_profile_to_addChild"
            app:destination="@id/addChildFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/slide_out_right" />

        <action
            android:id="@+id/action_profile_to_settings"
            app:destination="@id/settingsFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- SECONDARY destinations (not in bottom nav)                      -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <!-- AddEntry — called from Tracker -->
    <fragment
        android:id="@+id/addEntryFragment"
        android:name="com.example.sabicare_j.ui.tracker.AddEntryFragment"
        android:label="@string/add_entry"
        tools:layout="@layout/fragment_add_entry">
        <argument
            android:name="measurementType"
            app:argType="string"
            android:defaultValue="HEIGHT" />
    </fragment>

    <!-- AddChild — called from Profile and Onboarding -->
    <fragment
        android:id="@+id/addChildFragment"
        android:name="com.example.sabicare_j.ui.profile.AddChildFragment"
        android:label="@string/add_child"
        tools:layout="@layout/fragment_add_child">
        <!-- -1 means "add new", positive ID means "edit existing" -->
        <argument
            android:name="childId"
            app:argType="long"
            android:defaultValue="-1L" />
    </fragment>

    <!-- Settings — called from Profile -->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.sabicare_j.ui.profile.SettingsFragment"
        android:label="@string/settings"
        tools:layout="@layout/fragment_settings" />

</navigation>
