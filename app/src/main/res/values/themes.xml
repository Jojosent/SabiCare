<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SabiCare" parent="Theme.Material3.DayNight.NoActionBar">

        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>

        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorTertiaryContainer">@color/tertiary_container</item>

        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnBackground">@color/on_background</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>

        <item name="colorError">@color/error</item>
        <item name="colorOnError">#FFFFFF</item>

        <item name="colorOutline">@color/outline</item>

        <item name="textAppearanceDisplayLarge">@style/TextAppearance.SabiCare.DisplayLarge</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.SabiCare.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.SabiCare.TitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.SabiCare.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.SabiCare.BodyMedium</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.SabiCare.LabelLarge</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.SabiCare.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.SabiCare.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.SabiCare.Large</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>

    </style>
    <style name="Theme.SabiCare.Splash" parent="Theme.SabiCare.NoActionBar">
        <item name="android:windowBackground">@color/primary</item>
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:navigationBarColor">@color/primary</item>
    </style>


    <style name="Theme.SabiCare.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.SabiCare.Onboarding" parent="Theme.SabiCare.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="TextAppearance.SabiCare.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/rubik_bold</item>
        <item name="android:textSize">36sp</item>
    </style>

    <style name="TextAppearance.SabiCare.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/rubik_semibold</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="TextAppearance.SabiCare.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/rubik_medium</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.SabiCare.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/rubik_regular</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.SabiCare.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/rubik_regular</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.SabiCare.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/rubik_medium</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ShapeAppearance.SabiCare.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.SabiCare.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.SabiCare.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Widget.SabiCare.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/outline</item>
    </style>

    <style name="Widget.SabiCare.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAppearance">@style/TextAppearance.SabiCare.LabelLarge</item>
    </style>

    <style name="Widget.SabiCare.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/primary</item>
        <item name="tint">@color/on_primary</item>
        <item name="fabSize">normal</item>
        <item name="shapeAppearance">@style/ShapeAppearance.SabiCare.Medium</item>
    </style>

    <style name="Widget.SabiCare.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_icon_color</item>
        <item name="itemTextColor">@color/bottom_nav_icon_color</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemRippleColor">@color/primary_container</item>
    </style>

    <style name="Widget.SabiCare.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/outline</item>
        <item name="hintTextColor">@color/on_surface_variant</item>
    </style>

    <style name="CircleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>